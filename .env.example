APP_PASSWORD=troque-esta-senha
SECRET_KEY=troque-esta-chave-secreta
ADMIN_EMAIL=seu-email@dominio.com

# No Vercel a coleta com Chrome não roda. Deixe ENABLE_HARVEST=0.
# ENABLE_HARVEST=1
# SESSION_HTTPS=1


# Coletas JSON ficam no repo privado buscar-passagens-dados.
# git clone https://github.com/palomavmenezes/buscar-passagens-dados.git data/harvest
# HARVEST_DIR=data/harvest

# Coleta no PC: horários aleatórios por região (não 00h/12h fixos). Origem padrão GIG.
HARVEST_ORIGIN=GIG
HARVEST_ORIGINS=GIG
HARVEST_PROGRAMS=latam
HARVEST_DATE_OFFSETS=30,90
HARVEST_TZ=America/Sao_Paulo

# Coletores próprios (Playwright + sua sessão no site da cia)
LATAM_MAX_ROUTES=6
LATAM_MAX_PER_RUN=6
LATAM_PAUSE_SECONDS=150
LATAM_MAX_IDA_CLICKS=10
LATAM_COOLDOWN_SECONDS=180
LATAM_BATCH_GAP_SECONDS=600
LATAM_HEADLESS=0
CIA_HEADLESS=0
CIA_PAUSE_SECONDS=150
# Azul e GOL/Smiles: Chrome visitante, sem conta.
# Azul: entre uma data e outra a pausa é 20–60s aleatórios, não este valor.
# Chrome do dia a dia com --remote-debugging-port=9222. Só entra se LATAM_USE_CDP=1.
# A coleta abre o Google Chrome normal, com o perfil logado.
# CHROME_CDP=http://127.0.0.1:9222
# LATAM_USE_CDP=0
# LATAM_FRESH_BROWSER=1 abre anônimo, sem cookies do perfil antigo.

# A coleta NÃO preenche LATAM, Azul nem Smiles.
# LATAM: cookies do perfil Chrome. Se pedir login, entre você na janela.
# Azul e GOL/Smiles: Chrome visitante, sem conta.
# SMILES_USER=
# SMILES_PASSWORD=

HOST=127.0.0.1
PORT=8765
